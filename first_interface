import tkinter as tk

pencere = tk.Tk()
pencere.title("First Interface")
pencere.geometry("300x200")

def selam_ver():
    isim = giris_kutusu.get()
    if isim.strip() == "":
        sonuc_yazisi.config(text = "Lütfen bir isim gir!")
    else:
        sonuc_yazisi.config(text = f"Merhaba {isim}!")

etiket = tk.Label(pencere, text = "Adınızı girin: ")
etiket.pack(pady = 5)

giris_kutusu =  tk.Entry(pencere)
giris_kutusu.pack(pady = 5)

buton = tk.Button(pencere, text = "Selam Ver", command = selam_ver)
buton.pack(pady = 10)

sonuc_yazisi = tk.Label(pencere, text = "", font = ("Segoe UI", 11, " bold"))
sonuc_yazisi.pack(pady = 10)

pencere.mainloop()